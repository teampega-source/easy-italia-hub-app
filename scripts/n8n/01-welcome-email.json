{
  "name": "EIH — Benvenuto nuovo utente",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "eih-new-user",
        "responseMode": "onReceived",
        "options": {},
        "authentication": "headerAuth"
      },
      "id": "webhook-trigger",
      "name": "Webhook nuovo utente",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "eih-webhook-auth",
          "name": "EIH Webhook Header"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "notifiche@easyitaliahub.it",
        "toEmail": "={{ $json.email }}",
        "subject": "Benvenuto su Easy Italia Hub! 🇮🇹",
        "emailType": "html",
        "message": "<!DOCTYPE html><html><body style='font-family:Inter,sans-serif;background:#f5f0e8;padding:32px'><div style='max-width:600px;margin:0 auto;background:#fff;border-radius:12px;padding:32px'><h1 style='color:#5a5040;font-family:Playfair Display,serif'>Benvenuto, {{ $json.name }}! 👋</h1><p style='color:#333'>Il tuo account su <strong>Easy Italia Hub</strong> è attivo.</p><p>Cosa puoi fare subito:</p><ul><li>🤖 Chiedere al Consigliere AI nella tua lingua</li><li>📋 Controllare lo stato del permesso di soggiorno</li><li>📚 Accedere alla guida documenti</li></ul><a href='https://easyitaliahub.it/dashboard' style='display:inline-block;background:#7d7058;color:#fff;padding:12px 24px;border-radius:8px;text-decoration:none;margin-top:16px'>Accedi ora →</a><p style='color:#999;font-size:12px;margin-top:32px'>Easy Italia Hub — italiano, English, සිංහල, தமிழ்</p></div></body></html>"
      },
      "id": "send-welcome-email",
      "name": "Email benvenuto (Resend)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "resend-smtp",
          "name": "Resend SMTP"
        }
      }
    },
    {
      "parameters": {
        "channel": "#nuovi-utenti",
        "text": "🎉 Nuovo utente: *{{ $json.name }}* ({{ $json.email }}) — lingua: {{ $json.language || 'it' }}"
      },
      "id": "slack-notify",
      "name": "Notifica Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "credentials": {
        "slackApi": {
          "id": "slack-creds",
          "name": "Slack EIH"
        }
      }
    }
  ],
  "connections": {
    "Webhook nuovo utente": {
      "main": [
        [
          {
            "node": "Email benvenuto (Resend)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email benvenuto (Resend)": {
      "main": [
        [
          {
            "node": "Notifica Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    "eih",
    "onboarding"
  ],
  "meta": {
    "note": "Il profilo è creato dal trigger handle_new_user di Supabase: n8n non deve inserire in public.users (tabella che non esiste). Webhook da chiamare dopo la registrazione, quando N8N_WEBHOOK_NEW_USER è configurato."
  }
}

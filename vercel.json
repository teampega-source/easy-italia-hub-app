  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' https://emrldtp.cc https://tp.media https://*.tile.openstreetmap.org https://unpkg.com data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com https://cdn.fontshare.com; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net https://js.stripe.com https://va.vercel-scripts.com https://www.googletagmanager.com https://emrldtp.cc https://challenges.cloudflare.com; connect-src 'self' https://emrldtp.cc https://tp.media https://nominatim.openstreetmap.org https://api.fontshare.com https://*.tile.openstreetmap.org https://*.supabase.co https://api.stripe.com https://vitals.vercel-insights.com https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https://challenges.cloudflare.com; frame-src 'self' https://tp.media https://js.stripe.com https://hooks.stripe.com https://challenges.cloudflare.com; base-uri 'self'; form-action 'self' https://checkout.stripe.com; frame-ancestors 'none'; object-src 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), interest-cohort=()"
        }
      ]
    },

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/flight-digest",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/email",
      "schedule": "30 7 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.easyitaliahub.it"
        }
      ],
      "destination": "https://easyitaliahub.it/$1",
      "permanent": true
    },
    {
      "source": "/abbonamenti",
      "destination": "/",
      "permanent": false
    },

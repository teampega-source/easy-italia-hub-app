{
"2fb5b5eb": "நீங்கள் இணையத்தில் இல்லை",
"478503eb": "வழிகாட்டிகள்",
"52f50eae": "முகப்பு",
"58001e9f": "அவசரநிலையில் அழையுங்கள்",
"_meta": {
"copertura": 100,
"lingua": "ta",
"pagina": "offline"
},
"ba5ec0f1": "இப்போது இணைப்பு இல்லை. நீங்கள் ஏற்கனவே பார்த்த பக்கங்கள் இன்னும் உள்ளன: கீழே ஒன்றைத் திறந்து பாருங்கள்.",
"bac25b93": ": கட்டணமோ டேட்டாவோ இல்லாமலும் வேலை செய்யும்.",
"de7310b2": "அவசர எண்கள்"
}

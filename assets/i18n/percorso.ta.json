{
"044fc0e3": "சொத்து",
"1d5802be": "வேலை",
"1da59f19": "முதல் 90 நாட்கள்: திசைகாட்டலும் அடிப்படைகளும்.",
"1f518b1d": "வீடு",
"209afbc0": "வருகை",
"2dd85080": "நிதிக் கல்வி",
"35531553": "குடும்பம்",
"38d66fca": "திற",
"3e7733c7": "முழு ஒருங்கிணைவு",
"52b02b40": "குடும்ப ஒன்றிணைவு, பள்ளி, குழந்தைகளின் ஆரோக்கியம்.",
"5ef9b7ea": "பூட்டப்பட்டுள்ளது",
"76260030": "உண்மையான எண்களுடன் சொந்தத் தொழிலுக்கு.",
"865170c6": "இந்தக் கட்டத்தைத் திறக்கப் பதிவு செய்யுங்கள்.",
"9bc135a7": "அனுமதி, வதிவிடம், சுகாதாரம் — மற்றும் காலக்கெடு கண்காணிப்பு.",
"_meta": {
"copertura": 100,
"lingua": "ta",
"pagina": "percorso"
},
"a1299280": "பாதுகாப்பான வாடகையிலிருந்து சொந்த வீடு வரை.",
"b8a36c16": "வேலை தேடுவது மட்டுமல்ல: அதை மேம்படுத்துவது.",
"cb030ebe": "சட்டப்பூர்வமாக்குதல்",
"cde0ac2c": "கடன், வீடு, முதல் கவனமான முதலீடு.",
"d325c070": "தொழில் தொடங்குதல்",
"dd29440e": "பயணத்தின் 9 கட்டங்கள்",
"e551e219": "பணம் தெளிவாக: வரி, பங்களிப்பு, சேமிப்பு.",
"fe29a9b2": "குடியுரிமை, வாக்குரிமை, முழு பங்கேற்பு."
}

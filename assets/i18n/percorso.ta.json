{
"038e8979": "உத்தரவாதம் அளிப்பவர்",
"044fc0e3": "சொத்து",
"079ba5b7": "சேமிப்பு",
"08c00cf8": "தகுதிகள் அங்கீகாரம்",
"142a59ee": "பிள்ளைகளைப் பள்ளியில் சேர்த்தல்",
"19ac8954": "ஓய்வூதியம்",
"1ccf6012": "குடும்ப ஒன்றிணைப்பு",
"1d5802be": "வேலை",
"1da59f19": "முதல் 90 நாட்கள்: திசைகாட்டலும் அடிப்படைகளும்.",
"1f518b1d": "வீடு",
"209afbc0": "வருகை",
"22d123c7": "நிலையான வரி முறை (Regime forfettario)",
"2dd85080": "நிதிக் கல்வி",
"35531553": "குடும்பம்",
"3e7733c7": "முழு ஒருங்கிணைவு",
"488592c1": "மோசடிகளைத் தவிர்த்தல்",
"52b02b40": "குடும்ப ஒன்றிணைவு, பள்ளி, குழந்தைகளின் ஆரோக்கியம்.",
"5893b41b": "கடன் வரலாறு",
"644a5d9f": "சுகாதார அட்டை (Tessera Sanitaria)",
"67182b3f": "இத்தாலிய SIM அட்டை",
"6bd42da8": "கணக்காளர் (Commercialista)",
"70e2a8c8": "பாதுகாப்பான வாடகை ஒப்பந்தம்",
"720c1e58": "சொந்த வீடு வாங்கும் பாதையில்",
"76260030": "உண்மையான எண்களுடன் சொந்தத் தொழிலுக்கு.",
"7893c248": "ஊதியச் சீட்டு கணிப்பான்",
"84f6d25d": "ஒற்றைக் குழந்தை உதவித்தொகை (Assegno Unico)",
"8aeda89a": "வரிப் பதிவு எண் (Partita IVA)",
"90f12462": "பாடநெறிகளும் பயிற்சியும்",
"92648f3e": "வீடு வாங்குதல்",
"9b015f37": "வரிகளையும் பங்களிப்புகளையும் புரிந்துகொள்ளுதல்",
"9bc135a7": "அனுமதி, வதிவிடம், சுகாதாரம் — மற்றும் காலக்கெடு கண்காணிப்பு.",
"_meta": {
"copertura": 82,
"lingua": "ta",
"pagina": "percorso"
},
"a1299280": "பாதுகாப்பான வாடகையிலிருந்து சொந்த வீடு வரை.",
"aff50d34": "காலக்கெடு கண்காணிப்பு",
"b0760da9": "தங்கும் அனுமதி (Permesso di Soggiorno)",
"b7170fdd": "குழந்தை மருத்துவர்",
"b8a36c16": "வேலை தேடுவது மட்டுமல்ல: அதை மேம்படுத்துவது.",
"c20bcc07": "சொந்தத் தொழில் தொடங்குதல்",
"c285e5d1": "அதிகாரப்பூர்வ வசிப்பிடப் பதிவு",
"c45437a1": "ஐரோப்பிய ஒன்றிய நீண்டகால தங்கும் அனுமதி",
"c6860647": "மொழி நிலை A2",
"c6adf9c5": "அடிப்படை வங்கிக் கணக்கு",
"cb030ebe": "சட்டப்பூர்வமாக்குதல்",
"cde0ac2c": "கடன், வீடு, முதல் கவனமான முதலீடு.",
"cef1ec2e": "முறையான வேலை ஒப்பந்தம்",
"d325c070": "தொழில் தொடங்குதல்",
"d5b3953e": "சமூகத்தில் முழுப் பங்கேற்பு",
"d813b038": "காப்பீடும் அவசரகால நிதியும்",
"d957e191": "தற்காலிக தங்குமிடம்",
"dd29440e": "பயணத்தின் 9 கட்டங்கள்",
"df8dc6fa": "ஊதியச் சீட்டைப் புரிந்துகொள்ளுதல்",
"e46cd261": "வரி எண் (Codice Fiscale)",
"e551e219": "பணம் தெளிவாக: வரி, பங்களிப்பு, சேமிப்பு.",
"ee3be8c5": "குடியுரிமை",
"fb3dd579": "வெளிநாட்டவர்களுக்கான வீட்டுக் கடன்",
"fe29a9b2": "குடியுரிமை, வாக்குரிமை, முழு பங்கேற்பு."
}

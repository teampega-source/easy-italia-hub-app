{
"0216028c": "எ.கா. வதிவிட அனுமதி காலாவதி",
"032feefb": "NASpI புதுப்பித்தல்",
"03a8f767": "இன்று",
"07859389": "அனுமதி கண்காணிப்பு",
"0b3fcdd7": "அடுத்த 30 நாட்களில் அவசர காலக்கெடுக்கள்",
"0dae2256": "மாதத்தின் நாட்கள்",
"1113a949": "வதிவிட அனுமதி",
"11d87cc4": "அருகிலுள்ள patronato, CAF, அலுவலகங்கள்",
"164a36fa": "காலக்கெடுக்களைச் சேமித்து நிர்வகியுங்கள்",
"16a6fd56": "விரைவுச் சேர்ப்புகள்",
"1c3f10f7": "காலக்கெடு நினைவூட்டல்களை மின்னஞ்சலில் பெறப் பதிவு செய்யுங்கள். கணக்கு இல்லாவிட்டால் அவை உங்கள் உலாவியில், இந்தச் சாதனத்தில் இருக்கும்.",
"21ebed1d": "புதிய காலக்கெடு",
"21ef9b17": "பணப் பரிமாற்றம்",
"2e441505": "வாய்ப்புகள்",
"30635f6c": "பாதைக் குறிப்பு",
"30e728b8": "காலக்கெடுக்கள்",
"3440ebbc": "உங்கள் காலக்கெடுக்கள் சேமிக்கப்படுவது",
"34e72f04": "காலக்கெடு",
"35687ef4": "நடப்பு மாதத்திற்குச் செல்",
"3ccce915": "படிவங்களும் கடிதங்களும்",
"46040b95": "இந்தச் சாதனத்தில்",
"478503eb": "வழிகாட்டிகள்",
"4962147d": "காலக்கெடுக்களைப் பெறுங்கள்",
"49cd76da": "(எடுத்துக்காட்டுகள் — தேர்ந்தெடுத்த தேதி அல்லது இன்று)",
"4f2fb1ed": "உங்கள் CV-ஐ உருவாக்கிப் பதிவிறக்குங்கள்",
"52f50eae": "முகப்பு",
"5377ca91": "விமானங்கள், பாடநெறிகள், வேலை, அறிவிப்புகள்",
"576e5c36": "விரைவுச் சேர்ப்புகளை",
"58d9f08d": "இன்றைய குறிப்பு",
"70038527": "ஆவணங்கள்",
"78409fb3": "Questura சந்திப்பு",
"7cced1fb": "காலக்கெடு சேர்",
"857b1227": "எங்களுடன் நாட்கள்",
"85c7de63": "CV உருவாக்கி",
"85d8175e": "எனது பயணம்",
"8a8753c7": "மின்னஞ்சல்",
"91750062": "கால அட்டவணையும் உருவகப்படுத்திகளும்",
"94feff94": "தொடங்க இடதுபுறம்.",
"9c6a2f5f": "தொடர்பு",
"9fa9d3a0": "இன்னும் பதக்கம் இல்லை — தேர்வு & பதக்கம் எழுதுங்கள் →",
"_meta": {
"copertura": 62,
"lingua": "ta",
"pagina": "dashboard"
},
"aa2c8458": "காலக்கெடு 7 நாட்களுக்குள் வரும்போது எச்சரிக்க உலாவி நினைவூட்டல்களை இயக்குங்கள்.",
"aaaff826": "தேதிப்படி வரிசைப்படுத்தப்பட்டு, மீதமுள்ள நாட்களுடன்.",
"aee1bd05": "உங்கள் பயணத்திலிருந்து இலவசமாகப் பதிவு செய்யுங்கள்",
"b6a59549": "பரிந்துரைகளும் உதவியும்",
"ba1dbc5a": "இன்னும் காலக்கெடு இல்லை. நாட்காட்டியில் ஒரு நாளைச் சொடுக்குங்கள், அல்லது பயன்படுத்துங்கள்",
"bb3d94a8": "சேவை வரைபடம்",
"c5b24fbe": "பரிமாற்றச் சேவைகளை ஒப்பிடுங்கள்",
"c6ed65d6": "சுயவிவரம் நிறைவு",
"ce7d9e3c": "Patronato, CAF, அலுவலகங்கள்",
"cf7df2b3": "காலக்கெடு பரிந்துரைகள்",
"d559270e": "சமூகம்",
"d6ff4b08": "நீங்கள் விரும்பும்போது.",
"d8f2a6b4": "அடுத்த மாதம்",
"daa24f5c": "நிரப்பத் தயாரான வார்ப்புருக்கள்",
"db2fd44c": "7 நாட்களுக்குள்",
"ded1d01c": "உலாவி அறிவிப்புகளைத் தடுத்துள்ளது — தள அமைப்புகளில் அனுமதியுங்கள்",
"e0d5e9fb": "காலக்கெடு சேர்க்க ஒரு நாளைச் சொடுக்குங்கள்.",
"e209db61": "CPIA பாடநெறிப் பதிவு",
"e2ea936a": "படிப்படியான ஆவணங்கள்",
"e5f1dd2a": "உங்கள் புதுப்பித்தலின் நிலையைக் கண்காணியுங்கள்",
"e86dc94e": "அவற்றை உங்கள் அனைத்துச் சாதனங்களிலும் ஒத்திசைக்கவும் மின்னஞ்சலில் நினைவூட்டல் பெறவும்.",
"f54d4902": "ரத்து",
"fd9d30a1": "கேளுங்கள், பகிருங்கள்",
"ff06614e": "முந்தைய மாதம்"
}
